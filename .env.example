# ── Base de datos (Postgres, modo principal) ─────────────────────────────────
# Levantala con:  npm run db:up && npm run db:migrate
# (levanta un contenedor postgres en el puerto 5433 vía docker-compose.yml)
DATABASE_URL=postgres://remates:remates@localhost:5433/remates

# En producción: cadena de conexión a tu Postgres (servidor con disco persistente).
# DATABASE_URL=postgres://usuario:password@host:5432/base

# ── Administración (SOLO servidor) ───────────────────────────────────────────
# Contraseña maestra del panel /admin. Cambiala antes de publicar.
ADMIN_PASSWORD=cambia-esta-password

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Campos del Uruguay

# ── Contacto (opcional en MVP) ───────────────────────────────────────────────
# Formateo internacional, ej: 59899123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
