# ── Base de datos local (Postgres, modo principal) ───────────────────────────
# Levantala con:  npm run db:up && npm run db:migrate
# (levanta un contenedor postgres en el puerto 5433 vía docker-compose.yml)
DATABASE_URL=postgres://remates:remates@localhost:5433/remates

# ── Supabase (alternativa en la nube) ────────────────────────────────────────
# Proyecto: Supabase → Project Settings → API

# Pública (segura en el cliente). RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Privada (SOLO servidor. Nunca con prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# ── Administración (SOLO servidor) ───────────────────────────────────────────
# Contraseña maestra del panel /admin. Cambiala antes de publicar.
ADMIN_PASSWORD=cambia-esta-password

# ── Sitio ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Campos del Uruguay

# ── Contacto (opcional en MVP) ───────────────────────────────────────────────
# Formateo internacional, ej: 59899123456
NEXT_PUBLIC_WHATSAPP_NUMBER=
