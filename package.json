{
  "name": "remates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "up": "bash levantar.sh",
    "up:dev": "bash levantar.sh --dev",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "node --env-file=.env scripts/db.mjs migrate",
    "db:status": "node --env-file=.env scripts/db.mjs status",
    "db:reset": "node --env-file=.env scripts/db.mjs reset"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-boundaries": "7.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9",
    "vitest": "^5.0.3"
  }
}
